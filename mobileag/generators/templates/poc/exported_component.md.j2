```bash
# Start the service
adb shell am startservice -n {{ package_name }}/{{ class_name }}

# Start with intent data
adb shell am startservice -n {{ package_name }}/{{ class_name }} \
  --es "command" "dump_data" \
  --es "target" "/data/data/{{ package_name }}/databases/"
```
{% endif %}

