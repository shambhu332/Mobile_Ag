GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
QDRANT_HOST=localhost
QDRANT_PORT=6333
POSTGRES_URI=postgresql://user:pass@localhost:5432/mobileag
JADX_PATH=/usr/local/bin/jadx
APKTOOL_PATH=/usr/local/bin/apktool
GHIDRA_PATH=/opt/ghidra
OUTPUT_DIR=./output

# Dashboard authentication: leave blank to generate a fresh terminal-only token.
MOBILEAG_API_TOKEN=
# Comma-separated exact device serials and optional ADB connect endpoints.
MOBILEAG_ALLOWED_DEVICES=
MOBILEAG_ALLOWED_CONNECT=
# Explicit HTTP(S) origins, including non-default ports; redirects are not followed.
MOBILEAG_ALLOWED_ORIGINS=
MOBILEAG_ALLOW_PRIVATE_TARGETS=0
# Additional hostnames only when intentionally binding remotely.
MOBILEAG_ALLOWED_HOSTS=
MOBILEAG_PROXY_TOKEN=
QDRANT_API_KEY=
OFFLINE=true
