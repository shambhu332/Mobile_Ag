GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
QDRANT_HOST=localhost
QDRANT_PORT=6333
POSTGRES_URI=postgresql://user:pass@localhost:5432/mobileag
JADX_PATH=/usr/local/bin/jadx
APKTOOL_PATH=/usr/local/bin/apktool
GHIDRA_PATH=/opt/ghidra
OUTPUT_DIR=./output

# Dashboard authentication: leave blank to generate a fresh terminal-only token.
MOBILEAG_API_TOKEN=
# Comma-separated exact device serials and optional ADB connect endpoints.
MOBILEAG_ALLOWED_DEVICES=
MOBILEAG_ALLOWED_CONNECT=
# Explicit HTTP(S) origins, including non-default ports; redirects are not followed.
MOBILEAG_ALLOWED_ORIGINS=
MOBILEAG_ALLOW_PRIVATE_TARGETS=0
# Optional additional trusted Host headers; server binding remains loopback-only.
MOBILEAG_ALLOWED_HOSTS=
MOBILEAG_PROXY_TOKEN=
QDRANT_API_KEY=
OFFLINE=true

# JSON list of exact approved router names; keys alone never authorize cloud egress.
APPROVED_LLM_PROVIDERS=[]

# Web static jobs require Linux bubblewrap and an ordinary-user systemd manager.
# Optional trusted APKTool JAR mounted read-only in the sandbox (never an app upload).
# MOBILEAG_SANDBOX_APKTOOL_JAR=/absolute/path/to/apktool.jar
